{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "types": ["node", "vite/client"]
  },
  "include": [
    "apps/*/src",
    "apps/desktop/vite.config.ts",
    "packages/*/src",
    "tests"
  ]
}
